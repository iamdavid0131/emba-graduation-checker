{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emba-graduation-checker",
  "main": "worker.js",
  "compatibility_date": "2026-05-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // 只有 /api/* 會進 Worker，其餘直接回靜態檔
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emba-reviews",
      "database_id": "60748584-8df2-4c6d-8971-87333fe9896f"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
